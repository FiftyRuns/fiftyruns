{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "baseBranches": [
        "stage"
    ],
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ],
            "automerge": true
        }
    ],
    "vulnerabilityAlerts": {
        "enabled": true,
        "automerge": true
    },
    "prHourlyLimit": 0,
    "prConcurrentLimit": 0
}