// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

/**
 * ===================== Enums =====================
 */

enum Visibility {
  public
  protected
  private
}

enum DonationMultiplier {
  x1
  x2
  x5
  x10
}

enum ChallengeGoalType {
  DISTANCE
  TIME
  RUNS
}

enum GroupRole {
  MEMBER
  ADMIN
}

enum GroupJoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum NotificationCategory {
  REACTION
  COMMENT
  TEAM
  RUN
  SYSTEM
  INTEGRATION
}

enum NotificationActionType {
  TEAM_JOIN_REQUEST
}

enum ActivitySource {
  MANUAL
  GARMIN
  STRAVA
}

/**
 * ===================== Core Models =====================
 */

model Group {
  id     String @id @default(uuid())
  name   String @unique
  nameId String @unique

  description     String?
  location        String?
  coverImage      String?
  visibility      Visibility @default(public)
  requireApproval Boolean    @default(true)
  maxMembers      Int?

  users        User[]             @relation("UsersInGroup")
  challenges   Challenge[]
  joinRequests GroupJoinRequest[]
  invites      GroupInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupJoinRequest {
  id        String                 @id @default(uuid())
  groupId   String
  userId    String
  status    GroupJoinRequestStatus @default(PENDING)
  message   String?
  createdAt DateTime               @default(now())
  decidedAt DateTime?

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([groupId, userId])
  @@index([status])
}

model GroupInvite {
  id           String    @id @default(uuid())
  groupId      String
  invitedById  String
  targetUserId String?
  email        String?
  token        String    @unique
  note         String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  createdAt    DateTime  @default(now())

  group      Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy  User  @relation("GroupInviteSentBy", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("GroupInviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  targetUser User? @relation("GroupInviteTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([token])
  @@index([targetUserId])
}

model User {
  id                            String              @id @default(uuid())
  name                          String              @unique
  nameId                        String              @unique
  email                         String              @unique
  emailVerified                 Boolean             @default(false)
  emailVerificationToken        String?
  password                      String
  passwordResetToken            String?
  passwordResetTokenExpiry      DateTime?
  image                         String?
  bio                           String?
  profileVisibility             Visibility          @default(protected)
  notificationsEnabled          Boolean             @default(true)
  profileSettingsUpdatedAt      DateTime?
  runDonationMultiplier         DonationMultiplier?
  runDonationMultiplierAskAgain DateTime?
  autoDonate                    Boolean             @default(false)
  donationUpdatedAt             DateTime?

  groupId   String?
  group     Group?     @relation("UsersInGroup", fields: [groupId], references: [id], onDelete: SetNull)
  groupRole GroupRole? @default(MEMBER)

  createdAt DateTime? @default(now())

  // 🔴 OAuth 1.0 (WIRD ENTFERNT NACH MIGRATION)
  garminAccessToken       String?
  garminAccessTokenSecret String?

  // 🟢 OAuth 2.0 (NEU)
  garminOAuth2AccessToken  String?
  garminOAuth2RefreshToken String?
  garminOAuth2TokenExpiry  DateTime?
  garminConnectedAt        DateTime?
  garminUserId             String? // User ID von Garmin API

  comments             Comment[]
  GarminAuth           GarminAuth?
  GarminOAuth2         GarminOAuth2?
  GarminTokenExchange  GarminTokenExchange?
  postings             Posting[]
  reactions            Reaction[]
  readNotifications    ReadNotification[]
  notifications        Notification[]
  groupJoinRequests    GroupJoinRequest[]
  groupInvitesSent     GroupInvite[]        @relation("GroupInviteSentBy")
  groupInvitesAccepted GroupInvite[]        @relation("GroupInviteAcceptedBy")
  groupInvitesTargeted GroupInvite[]        @relation("GroupInviteTarget")
  runningStatistic     RunningStatistic?
  sessions             Session[]

  // NEU: Challenge-Beziehungen (wie gehabt)
  challengesAdmin  Challenge[]          @relation("ChallengeAdmin")
  challengeMembers ChallengeMember[]
  challengeScores  ChallengeHighscore[]

  // 🟠 Strava OAuth 2.0
  stravaAthleteId      String?            @unique
  stravaAccessToken    String?
  stravaRefreshToken   String?
  stravaTokenExpiresAt DateTime?
  stravaScopes         String[]           @default([])
  stravaConnectedAt    DateTime?
  stravaDeauthorizedAt DateTime?
  stravaOAuthStates    StravaOAuthState[]

  @@unique([nameId, email])
  @@index([emailVerificationToken])
  @@index([runDonationMultiplierAskAgain, runDonationMultiplier])
  @@index([groupId])
  @@index([garminUserId]) // Index für Garmin User ID
}

// 🔴 OAuth 1.0 (WIRD ENTFERNT NACH MIGRATION)
model GarminAuth {
  oauthToken       String @id
  oauthTokenSecret String
  userId           String @unique
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 🟢 OAuth 2.0 PKCE Flow (NEU)
model GarminOAuth2 {
  id           String   @id @default(uuid())
  codeVerifier String
  state        String?
  userId       String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime @default(dbgenerated("NOW() + INTERVAL '10 minutes'"))
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt]) // Für Cleanup Jobs
}

// 🟢 Token Exchange Tracking (für Migration)
model GarminTokenExchange {
  id                String    @id @default(uuid())
  userId            String    @unique
  oauth1Token       String // Original OAuth 1.0 Token
  exchangeAttempted Boolean   @default(false)
  exchangeSuccess   Boolean?
  exchangeError     String?
  exchangedAt       DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([exchangeSuccess])
  @@index([createdAt])
}

// 🟠 Strava OAuth State
model StravaOAuthState {
  state     String   @id
  userId    String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Posting {
  id                String     @id @default(uuid())
  date              DateTime
  text              String?
  image             String?
  userId            String
  visibility        Visibility @default(protected)
  runningExerciseId String?
  season            String

  comments        Comment[]
  donation        Donation?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions       Reaction[]
  runningExercise RunningExercise?
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  date      DateTime @default(now())
  userId    String
  postingId String
  posting   Posting  @relation(fields: [postingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reaction {
  id        String   @id @default(uuid())
  type      String
  date      DateTime @default(now())
  userId    String
  postingId String?
  Posting   Posting? @relation(fields: [postingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postingId])
}

model Donation {
  id           String   @id @default(uuid())
  amountInCent Int
  date         DateTime @default(now())
  postingId    String   @unique
  posting      Posting  @relation(fields: [postingId], references: [id], onDelete: Cascade)
}

model RunningExercise {
  id                String         @id @default(uuid())
  distanceInMeters  Int
  durationInSeconds Int
  postingId         String         @unique
  garminActivityId  String?        @unique
  stravaActivityId  String?        @unique
  source            ActivitySource @default(MANUAL)
  posting           Posting        @relation(fields: [postingId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())

  @@index([source])
}

model RunningStatistic {
  id                String @id @default(uuid())
  numberOfRuns      Int
  distanceInMeters  Int
  durationInSeconds Int
  userId            String @unique
  season            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReadNotification {
  id             String       @id @default(uuid())
  userId         String
  notificationId String
  readAt         DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
}

model Notification {
  id            String                  @id @default(uuid())
  userId        String
  category      NotificationCategory
  type          String
  title         String
  message       String
  link          String?
  data          Json?
  actionType    NotificationActionType?
  actionPayload Json?
  joinRequestId String?
  createdAt     DateTime                @default(now())
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  readBy        ReadNotification[]
  joinRequest   GroupJoinRequest?       @relation(fields: [joinRequestId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([joinRequestId])
}

model StravaWebhookSubscription {
  id                   String   @id @default(uuid())
  stravaSubscriptionId Int      @unique
  callbackUrl          String
  verifyToken          String
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model StravaWebhookEvent {
  id             String    @id @default(uuid())
  deliveryId     String?   @unique
  eventTime      DateTime
  objectType     String
  aspectType     String
  objectId       String?
  ownerId        String?
  subscriptionId Int?
  updates        Json?
  signatureValid Boolean?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@index([objectId])
  @@index([ownerId])
  @@index([processedAt])
}

model GarminWebhookEvent {
  id         String    @id @default(uuid())
  payload   Json
  receivedAt DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt])
}

/**
 * ===================== Challenges =====================
 */

model Challenge {
  id          String   @id @default(uuid())
  name        String
  nameId      String   @unique
  description String?
  prize       String?
  image       String?
  startAt     DateTime
  endAt       DateTime

  goalType            ChallengeGoalType
  goalDistanceMeters  Int?
  goalDurationSeconds Int?
  goalRuns            Int?

  minDistanceMeters  Int?
  minDurationSeconds Int?

  visibility   Visibility @default(public)
  sponsorLogos String[]

  adminUserId String
  admin       User   @relation("ChallengeAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  members    ChallengeMember[]
  highscores ChallengeHighscore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt, endAt])
  @@index([visibility])
}

model ChallengeMember {
  id          String   @id @default(uuid())
  challengeId String
  userId      String
  joinedAt    DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
}

model ChallengeHighscore {
  id          String @id @default(uuid())
  challengeId String
  userId      String

  runsCount         Int @default(0)
  distanceInMeters  Int @default(0)
  durationInSeconds Int @default(0)

  progressPercent Int @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([progressPercent])
}
