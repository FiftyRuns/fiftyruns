{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["nuxt", "@types/node", "@nuxt/image"],
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "~~/*": ["./*"],
      "@/*": ["./app/*"],
      "@@/*": ["./app/*"]
    }
  },
  "include": [
    ".nuxt",
    "nuxt.config.ts",
    "app.config.ts",
    "app/**/*.ts",
    "app/**/*.vue",
    "server/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
