{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["nuxt", "@types/node", "@nuxt/content", "@nuxt/image"],
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "~~/*": ["./*"],
      "@/*": ["./app/*"],
      "@@/*": ["./app/*"],
      "#imports": ["./.nuxt/imports.d.ts"]
    }
  },
  "include": [
    ".nuxt",
    "nuxt.config.ts",
    "app.config.ts",
    "app/types/**/*.d.ts",
    "plugins/**/*.ts",
    "server/**/*.ts",
    "pages/**/*.vue",
    "components/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
